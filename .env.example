# Copy to .env and fill in what you need. Every value is optional: an empty or missing one uses the default in config.php.
# Quote values that contain spaces or special characters:  FUNNEL_DB_PASS='a;b%c[d]'

# ---- Database (lib/LeadRepository.php)
FUNNEL_DB_HOST=localhost
FUNNEL_DB_PORT=3306
FUNNEL_DB_NAME=
FUNNEL_DB_USER=
FUNNEL_DB_PASS=
FUNNEL_DB_TABLE=dynamic_remedy

# ---- Funnel API (empty = data/updated-sample-funnel.json)
FUNNEL_API_URL=
FUNNEL_API_TOKEN=

# ---- Vrio prospect (X-Api-Key header)
FUNNEL_VRIO_API_KEY=
FUNNEL_VRIO_CONNECTION_ID=
FUNNEL_VRIO_API_URL=

# ---- GoHighLevel
FUNNEL_GHL_TOKEN=
FUNNEL_GHL_LOCATION_ID=
FUNNEL_GHL_API_URL=

# ---- xverify
FUNNEL_XVERIFY_API_KEY=
FUNNEL_XVERIFY_DOMAIN=
FUNNEL_XVERIFY_API_URL=

# ---- Membership check (empty = built-in sample: returns false → campaign_set)
FUNNEL_MEMBERSHIP_API_URL=
FUNNEL_MEMBERSHIP_API_TOKEN=

# ---- Google Places address autocomplete on checkout (browser key)
FUNNEL_GOOGLE_MAPS_KEY=

# ---- Other
FUNNEL_PROJECT=chime
FUNNEL_PAYMENT_DRIVER=vrio        # vrio = real pre-auth, test = approves FUNNEL_TEST_CARD only, none = refuses
FUNNEL_TEST_CARD=4111 2222 3333 4444
