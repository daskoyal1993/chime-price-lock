# Copy to .env and fill in what you need. Every value is optional: an empty or missing one uses the default in config.php.
# Quote values that contain spaces or special characters:  FUNNEL_DB_PASS='a;b%c[d]'

# ---- Database (lib/LeadRepository.php)
FUNNEL_DB_HOST=localhost
FUNNEL_DB_PORT=3306
FUNNEL_DB_NAME=
FUNNEL_DB_USER=
FUNNEL_DB_PASS=
FUNNEL_DB_TABLE=dynamic_remedy

# ---- Funnel API (empty = the local sample file, config.php → sample_file)
FUNNEL_API_URL=
FUNNEL_API_TOKEN=

# ---- Vrio prospect (X-Api-Key header)
FUNNEL_VRIO_API_KEY=
FUNNEL_VRIO_CONNECTION_ID=
FUNNEL_VRIO_API_URL=

# ---- GoHighLevel
FUNNEL_GHL_TOKEN=
FUNNEL_GHL_LOCATION_ID=
FUNNEL_GHL_API_URL=

# ---- xverify
FUNNEL_XVERIFY_API_KEY=
FUNNEL_XVERIFY_DOMAIN=
FUNNEL_XVERIFY_API_URL=

# ---- Membership check (empty = built-in sample: returns false → campaign_set)
FUNNEL_MEMBERSHIP_API_URL=
FUNNEL_MEMBERSHIP_API_TOKEN=

# ---- Vrio pre-auth at checkout (in addition to the Vrio settings above)
FUNNEL_VRIO_SHIPPING_PROFILE_ID=

# ---- Tenant secret key (Portal → Site Settings → Secret Key): checks the funnel JSON credentials and signs the portal order.
#      Required for process.php. Empty = the funnel credentials are read without the signature check.
FUNNEL_TENANT_SECRET_KEY=

# ---- Vouched identity check (empty = the keys from the funnel JSON, tenant.vouched)
FUNNEL_VOUCHED_API_KEY=
FUNNEL_VOUCHED_APP_ID=
FUNNEL_VOUCHED_API_URL=

# ---- Patient portal order hand-off (process.php)
FUNNEL_PORTAL_API_KEY=
FUNNEL_PORTAL_API_URL=

# ---- Google Places address autocomplete on checkout (browser key)
FUNNEL_GOOGLE_MAPS_KEY=

# ---- QA error log (lib/ErrorLogger.php → storage/logs/qa-errors.log; read with `php tools/qa-errors.php` or qa-errors.php?key=…)
FUNNEL_ENV=local                 # local | staging | live
FUNNEL_QA_ERRORS=1               # 0 = off
FUNNEL_QA_KEY=                   # web viewer key; also required for ?qa_test=start on live
FUNNEL_QA_VIEWER_ON_LIVE=0       # 1 = allow qa-errors.php on live (with the key)

# ---- Other
FUNNEL_PROJECT=chime
FUNNEL_PAYMENT_DRIVER=vrio        # vrio = real pre-auth (the test card is sent to Vrio), test = approves FUNNEL_TEST_CARD only, none = refuses
FUNNEL_TEST_CARD=4111 2222 3333 4444
